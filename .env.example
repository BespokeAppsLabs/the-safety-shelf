# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

# Clerk — from dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex-side (not read by Next.js) — set with:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=

# Convex-side web research credential — set with `npx convex env set FIRECRAWL_API_KEY`.
# FIRECRAWL_API_KEY=

# Payments (Paystack). All three are Convex-side — the secret key must never be
# readable by the browser, and APP_URL is the fixed post-checkout return target
# (a client-supplied one would be an open redirect). See docs/10-payments.md.
#   npx convex env set PAYSTACK_SECRET_KEY sk_test_...
#   npx convex env set PAYSTACK_SPLIT_CODE SPL_...
#   npx convex env set APP_URL http://localhost:5050
# PAYSTACK_SECRET_KEY=
# PAYSTACK_SPLIT_CODE=
# APP_URL=

# Convex-side encryption key for provider tokens at rest (AES-256-GCM, see
# convex/lib/secrets.ts). Generate per deployment — NEVER share one across dev
# and prod, and never rotate in place: the salt is fixed, so a new key orphans
# every stored aiCredentials row.
#   npx convex env set AI_CREDENTIALS_ENCRYPTION_KEY "$(openssl rand -base64 32)"
# AI_CREDENTIALS_ENCRYPTION_KEY=

# Convex-side. Base URL used to build shareable book links in social posts
# (convex/socialActions.ts). MUST be set in production — the fallback points at
# a domain we do not own.
#   npx convex env set STORE_PUBLIC_URL https://www.safety-shelf.co.za
# STORE_PUBLIC_URL=

# Next.js-side, optional. Canonical origin used by metadata, robots.txt,
# sitemap.xml, llms.txt and JSON-LD (lib/seo.ts). Defaults to the live domain —
# only set it on a preview/staging deployment that must not claim to be
# www.safety-shelf.co.za.
# NEXT_PUBLIC_SITE_URL=

# Convex-side, optional. Publishing stays inert until both are set.
# POSTIZ_API_URL=
# POSTIZ_API_KEY=

# CI/hosting only — never in .env.local. Vercel Production holds a
# `deployment:deploy`-scoped prod deploy key, and the build command
# `npx convex deploy --cmd 'yarn build'` injects NEXT_PUBLIC_CONVEX_URL at build
# time, so that variable must NOT be set in Vercel.
# CONVEX_DEPLOY_KEY=
