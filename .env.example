# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — from dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex-side (not read by Next.js) — set with:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=

# Convex-side web research credential — set with `npx convex env set FIRECRAWL_API_KEY`.
# FIRECRAWL_API_KEY=

# Payments (Paystack). All three are Convex-side — the secret key must never be
# readable by the browser, and APP_URL is the fixed post-checkout return target
# (a client-supplied one would be an open redirect). See docs/10-payments.md.
#   npx convex env set PAYSTACK_SECRET_KEY sk_test_...
#   npx convex env set PAYSTACK_SPLIT_CODE SPL_...
#   npx convex env set APP_URL http://localhost:5050
# PAYSTACK_SECRET_KEY=
# PAYSTACK_SPLIT_CODE=
# APP_URL=
